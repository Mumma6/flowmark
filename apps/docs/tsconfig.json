{
  "extends": "../../packages/config/typescript/base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "next-env.d.ts",
    "mermaid-esm.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".source/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
