{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "ignoreCommand": "cd ../.. && node scripts/vercel-should-deploy.mjs @flowmark/web",
  "buildCommand": "cd ../.. && pnpm exec turbo build --filter=@flowmark/web",
  "git": {
    "deploymentEnabled": {
      "staging": false,
      "main": false
    }
  }
}
