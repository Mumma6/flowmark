FLOWMARK_DASHBOARD_ORIGIN=http://localhost:3001
FLOWMARK_DEMO_MODE=true
# Public local-only Compose defaults. Existing env files are never overwritten.
FLOWMARK_LOCAL_DATABASE=compose
FLOWMARK_POSTGRES_PORT=55432
DATABASE_URL=postgresql://flowmark:local_dev_only@127.0.0.1:55432/flowmark
BETTER_AUTH_URL=http://localhost:3001
# Required outside local demo mode. Local demo falls back to a development secret.
# BETTER_AUTH_SECRET=
# Optional direct/session URL for migrations. Defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://flowmark:local_dev_only@127.0.0.1:55432/flowmark
