{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_MIGRATION_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY",
        "FLOWMARK_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": {
      "dependsOn": ["dev:ready"],
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "DATABASE_MIGRATION_URL",
        "FLOWMARK_*",
        "DOCKER_*",
        "COMPOSE_*",
        "NEXT_PUBLIC_*",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "RESEND_API_KEY"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_MIGRATION_URL",
        "FLOWMARK_*",
        "DOCKER_*",
        "COMPOSE_*"
      ]
    },
    "dev:ready": {
      "dependsOn": [
        "@flowmark/api#build",
        "@flowmark/auth#build",
        "@flowmark/db#build",
        "@flowmark/mcp#build",
        "@flowmarkdev/core#build",
        "@flowmarkdev/node#build"
      ]
    }
  }
}
