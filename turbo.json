{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_MIGRATION_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "FLOWMARK_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "@flowmarkdev/node#build"],
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "FLOWMARK_*",
        "NEXT_PUBLIC_*",
        "SUPABASE_*"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
