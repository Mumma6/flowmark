{
  "name": "flowmark",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm dev:setup && turbo dev --ui=tui",
    "dev:stream": "pnpm dev:setup && turbo dev --ui=stream",
    "dev:setup": "node scripts/prepare-dev.mjs",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @flowmark/db db:generate",
    "db:studio": "pnpm --filter @flowmark/db db:studio",
    "db:migrate": "pnpm --filter @flowmark/db db:migrate",
    "db:seed": "pnpm --filter @flowmark/db db:seed",
    "db:setup": "pnpm --filter @flowmark/db db:setup",
    "db:setup-demo": "pnpm --filter @flowmark/db db:setup",
    "db:reset-local-telemetry": "pnpm --filter @flowmark/db db:reset-local-telemetry",
    "test": "node --test scripts/prepare-dev.test.mjs && turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
