{
  "name": "flowmark",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "rust:setup": "node scripts/rust.mjs setup",
    "rust:format": "node scripts/rust.mjs format",
    "rust:check": "node scripts/rust.mjs check",
    "rust:build": "node scripts/rust.mjs build",
    "engine:verify-build": "turbo build --filter=@flowmark/server && node scripts/verify-engine-build.mjs",
    "demo:plan": "pnpm --filter @flowmark/demo demo plan",
    "demo:setup": "pnpm --filter @flowmark/demo demo setup",
    "demo:seed": "pnpm --filter @flowmark/demo demo seed",
    "demo:reset": "pnpm --filter @flowmark/demo demo reset",
    "demo:reseed": "pnpm --filter @flowmark/demo demo reseed",
    "demo:status": "pnpm --filter @flowmark/demo demo status",
    "build": "turbo build",
    "dev": "pnpm dev:setup && pnpm infra doctor --require-ready && turbo dev --filter=@flowmark/server... --filter=@flowmark/dashboard... --filter=@flowmark/dev-harness... --filter=@flowmark/docs... --filter=@flowmark/internal-docs...",
    "dev:setup": "node scripts/prepare-dev.mjs",
    "infra": "pnpm --filter @flowmark/db infra",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @flowmark/db db:generate",
    "db:studio": "pnpm --filter @flowmark/db db:studio",
    "db:migrate": "pnpm --filter @flowmark/db db:migrate",
    "db:migrate:local": "pnpm --filter @flowmark/db db:migrate --local",
    "db:migrate:preview": "node scripts/db-migrate-preview.mjs",
    "db:migrate:staging": "node scripts/db-migrate-staging.mjs",
    "db:migrate:prod": "node scripts/db-migrate-production.mjs",
    "neon:env-pull": "node scripts/neon-env-pull.mjs",
    "check": "pnpm rust:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm engine:verify-build",
    "release:verify": "node scripts/release-verify.mjs",
    "db:seed": "pnpm --filter @flowmark/auth db:seed",
    "db:setup": "pnpm --filter @flowmark/auth db:setup",
    "db:reset-local-telemetry": "pnpm --filter @flowmark/db db:reset-local-telemetry",
    "test": "node --test scripts/*.test.mjs && turbo test",
    "test:integration": "pnpm --filter @flowmark/db test:integration",
    "typecheck": "turbo typecheck",
    "dev:all": "pnpm dev:setup && pnpm infra doctor --require-ready && turbo dev",
    "dev:stack": "pnpm dev:setup && pnpm infra up && turbo dev db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
