{
  "name": "@flowmarkdev/core",
  "version": "0.1.1",
  "description": "Shared workflow event contracts for Flowmark",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mumma6/flowmark.git",
    "directory": "packages/core"
  },
  "homepage": "https://flowmark.dev",
  "bugs": {
    "url": "https://github.com/Mumma6/flowmark/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "effect": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "workflow",
    "observability",
    "telemetry",
    "schema",
    "typescript",
    "flowmark"
  ]
}
