{
  "name": "@flowmark/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./demo": {
      "types": "./dist/fixtures/demo.d.ts",
      "import": "./dist/fixtures/demo.js"
    },
    "./auth-limits": {
      "types": "./dist/persistence/auth/auth-limits.d.ts",
      "import": "./dist/persistence/auth/auth-limits.js"
    },
    "./seed": {
      "types": "./dist/cli/local-seed.d.ts",
      "import": "./dist/cli/local-seed.js"
    },
    "./environment": {
      "types": "./dist/environment/preview-isolation.d.ts",
      "import": "./dist/environment/preview-isolation.js"
    }
  },
  "scripts": {
    "dev": "pnpm db:studio",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src drizzle.studio.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --config=drizzle.studio.config.ts --host=127.0.0.1 --port=4983",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:preview-baseline": "tsx src/cli/stamp-preview-baseline.ts",
    "db:schema-baseline": "tsx src/cli/stamp-preview-baseline.ts",
    "db:seed": "pnpm --filter @flowmark/auth db:seed",
    "db:setup": "pnpm --filter @flowmark/auth db:setup",
    "db:setup-demo": "pnpm --filter @flowmark/auth db:setup",
    "db:reset-local-telemetry": "tsx src/cli/reset-local-telemetry.ts",
    "test": "node --import tsx --test test/environment/runtime.test.ts test/environment/preview-isolation.test.ts test/persistence/continue-run.test.ts test/persistence/operation-summaries.test.ts test/cli/migration-history.test.ts test/persistence/run-facts.test.ts test/persistence/create-project.test.ts test/cli/run-facts-options.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrations:verify": "tsx src/cli/verify-migrations.ts",
    "db:facts:backfill": "tsx src/cli/backfill-run-facts.ts"
  },
  "dependencies": {
    "@flowmarkdev/core": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "effect": "4.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@types/node": "^22.18.6",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
