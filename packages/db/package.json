{
  "name": "@flowmark/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./demo": {
      "types": "./dist/fixtures/demo.d.ts",
      "import": "./dist/fixtures/demo.js"
    },
    "./auth": {
      "types": "./dist/auth/create-auth.d.ts",
      "import": "./dist/auth/create-auth.js"
    },
    "./environment": {
      "types": "./dist/environment/preview-isolation.d.ts",
      "import": "./dist/environment/preview-isolation.js"
    }
  },
  "scripts": {
    "dev": "pnpm db:studio",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --host=127.0.0.1 --port=4983",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:preview-baseline": "tsx src/cli/stamp-preview-baseline.ts",
    "db:schema-baseline": "tsx src/cli/stamp-preview-baseline.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:setup": "tsx src/cli/setup.ts",
    "db:setup-demo": "tsx src/cli/setup.ts",
    "db:reset-local-telemetry": "tsx src/cli/reset-local-telemetry.ts",
    "test": "node --import tsx --test test/environment/runtime.test.ts test/environment/preview-isolation.test.ts test/auth/secret.test.ts test/persistence/continue-run.test.ts test/persistence/operation-summaries.test.ts test/cli/migration-history.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrations:verify": "tsx src/cli/verify-migrations.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.13",
    "@flowmarkdev/core": "workspace:*",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.44.5",
    "effect": "4.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@types/node": "^22.18.6",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
