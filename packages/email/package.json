{
  "name": "@flowmark/email",
  "version": "0.1.0",
  "private": true,
  "description": "Server-only transactional email for Flowmark. Not published.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./dist/server-only.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "node --import tsx --test test/*.test.ts",
    "send:test": "tsx src/cli/send-test.ts"
  },
  "dependencies": {
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
