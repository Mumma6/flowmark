{
  "name": "@flowmark/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Flowmark MCP protocol adapter, tools, and HTTP handlers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.17",
    "@flowmark/api": "workspace:*",
    "@flowmark/auth": "workspace:*",
    "@flowmark/db": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2"
  }
}
