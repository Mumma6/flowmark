{
  "name": "@flowmark/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Flowmark MCP protocol adapter, tools, and HTTP handlers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.17",
    "@flowmark/api": "workspace:*",
    "@flowmark/auth": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "effect": "4.1.0",
    "@flowmark/evidence-view": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
