{
  "name": "@flowmarkdev/node",
  "version": "0.1.1",
  "description": "Workflow observability for processes your Node.js and Next.js apps already run",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/adapters/next.d.ts",
      "import": "./dist/adapters/next.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./next/proxy": {
      "types": "./dist/adapters/proxy.d.ts",
      "import": "./dist/adapters/proxy.js"
    },
    "./proxy": {
      "types": "./dist/adapters/proxy.d.ts",
      "import": "./dist/adapters/proxy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mumma6/flowmark.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.flowmark.dev",
  "bugs": {
    "url": "https://github.com/Mumma6/flowmark/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flowmarkdev/core": "workspace:*",
    "effect": "4.1.0"
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "next": "^16.4.2",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "workflow",
    "observability",
    "telemetry",
    "tracing",
    "nodejs",
    "nextjs",
    "typescript",
    "monitoring",
    "ops",
    "run",
    "flowmark"
  ]
}
