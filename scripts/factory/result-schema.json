{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "jobKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "coverage": {
      "enum": ["complete", "partial"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "category": {
            "enum": ["architecture", "documentation", "correctness"]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "ruleFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        },
        "required": [
          "id",
          "category",
          "file",
          "line",
          "evidence",
          "ruleFile",
          "impact",
          "suggestion"
        ],
        "additionalProperties": false
      }
    },
    "lessons": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "suggestedChange": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "benefit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                }
              },
              "required": ["number", "url", "quote"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "observation",
          "target",
          "suggestedChange",
          "benefit",
          "verification",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "jobKey",
    "coverage",
    "summary",
    "findings",
    "lessons"
  ],
  "additionalProperties": false
}
